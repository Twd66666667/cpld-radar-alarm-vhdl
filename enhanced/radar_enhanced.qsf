set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM1270T144C5
set_global_assignment -name TOP_LEVEL_ENTITY radar_enhanced_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 9.1
set_global_assignment -name LAST_QUARTUS_VERSION 9.1
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name FMAX_REQUIREMENT "1 MHz" -section_id clk_1mhz
set_instance_assignment -name CLOCK_SETTINGS clk_1mhz -to clk
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name VHDL_FILE ../rtl/timebase.vhd
set_global_assignment -name VHDL_FILE ../rtl/system_ctrl.vhd
set_global_assignment -name VHDL_FILE ../rtl/ultrasonic.vhd
